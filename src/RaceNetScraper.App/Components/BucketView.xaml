<UserControl x:Class="RaceNetScraper.App.Components.BucketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Loaded="UserControl_Loaded">
    <!-- Embedded in the "Bucket" tab of MainWindow — browse/delete files in the bucket's "pending"
         folder specifically (see S3BucketService.PendingFolder). That's the only folder this app
         itself ever reads or writes (scrape auto-uploads and manual uploads alike), so this is the
         one place worth showing — other folders that might exist in the bucket are unrelated data
         from outside this app. Reads AppSettings fresh on every refresh, so it always reflects
         whatever bucket is currently configured (see BucketViewModel). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="16" FontWeight="Bold">
                <Run Text="S3 Bucket — " />
                <Run Text="{Binding BucketName, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" />
                <Run Text=" / pending" Foreground="{StaticResource SubtleTextBrush}" />
            </TextBlock>
            <TextBlock FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                Browse and delete files in the "pending" folder — the only folder this app reads or writes. Deleting a file here removes it from S3 permanently — this cannot be undone.
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                <TextBlock Text="Access key" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                <TextBox Text="{Binding S3AccessKey, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,24,0"
                         ToolTip="S3 access key for this bucket. Remembered across app restarts (same plaintext settings.json as everything else here)." />

                <TextBlock Text="Secret key" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                <TextBox Text="{Binding S3SecretKey, UpdateSourceTrigger=PropertyChanged}" Width="260"
                         ToolTip="S3 secret key for this bucket. Remembered across app restarts (same plaintext settings.json as everything else here)." />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <Button Content="Refresh" Width="90" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
            <Button Content="Upload..." Width="100" Style="{StaticResource SecondaryButton}" Click="Upload_Click" Margin="0,0,16,0"
                    ToolTip="Upload one or more local files into the 'pending' folder — always there, regardless of the Bucket field on the Scraper tab, so uploads land somewhere predictable." />
            <Button Content="Select All" Width="100" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,10,0" />
            <Button Content="Clear Selection" Width="120" Style="{StaticResource SecondaryButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,10,0" />
            <Button Content="{Binding DeleteSelectedLabel}" Width="150" Click="DeleteSelected_Click"
                    IsEnabled="{Binding CanDeleteSelected}" Margin="0,0,16,0" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
            <ProgressBar Width="120" Margin="16,0,0,0" IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Objects}" AutoGenerateColumns="False"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="32" />
                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Last modified (UTC)" Binding="{Binding LastModifiedDisplay}" Width="160" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                        Click="DeleteOne_Click" Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
