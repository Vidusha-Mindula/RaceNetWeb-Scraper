<UserControl x:Class="RaceNetScraper.App.Components.ScraperBotIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignWidth="40" d:DesignHeight="44">
    <!--
        Small animated "bot" mascot shown in the header in place of the old "Developed by VM"
        badge — the WPF-native counterpart of ScraperBotLoader.razor in the web app, built from
        the same design (vector shapes here instead of SVG, same coordinate system shifted down
        by 20 so nothing sits at a negative Y).

        Two independent animation layers:
        - "Walk" (bob + arm swing + head tilt + side-to-side run across TrackWidth) runs
          continuously regardless of scrape state — built in code-behind (ScraperBotIndicator.xaml.cs)
          since the run distance depends on the header's actual width, which XAML can't compute.
        - "Active" (antenna/mic glow, eye blink, face scanline, chest pulse, mouth "talking") only
          plays while IsActive is true, signaling an actual scrape in progress.
    -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="HeadGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A9E8C4" Offset="0" />
            <GradientStop Color="#3FAE6F" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BodyGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3FAE6F" Offset="0" />
            <GradientStop Color="#1F6B40" Offset="1" />
        </LinearGradientBrush>

        <Storyboard x:Key="ActiveStoryboard" RepeatBehavior="Forever">
            <!-- Antenna glow pulse -->
            <DoubleAnimation Storyboard.TargetName="AntennaDot" Storyboard.TargetProperty="(Ellipse.Effect).(DropShadowEffect.BlurRadius)"
                              From="2" To="10" Duration="0:0:0.7" AutoReverse="True" />

            <!-- Eye blink -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyeLeft" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.816" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.944" Value="0.08" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.072" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyeRight" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                           BeginTime="0:0:0.05">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.816" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.944" Value="0.08" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.072" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="1" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Face scanline sweep -->
            <DoubleAnimation Storyboard.TargetName="ScanlineTransform" Storyboard.TargetProperty="Y"
                              From="-14" To="14" Duration="0:0:2.2" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanlineRect" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- Headset mic glow -->
            <DoubleAnimation Storyboard.TargetName="MicTip" Storyboard.TargetProperty="(Ellipse.Effect).(DropShadowEffect.BlurRadius)"
                              From="1" To="8" Duration="0:0:0.9" AutoReverse="True" />

            <!-- Chest light pulse -->
            <DoubleAnimation Storyboard.TargetName="ChestLight" Storyboard.TargetProperty="Opacity"
                              From="0.5" To="1" Duration="0:0:0.7" AutoReverse="True" />

            <!-- Mouth "talking" while actively reporting progress -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mouth" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.6" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1.3" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Viewbox Width="76" Height="86" Stretch="Uniform" ToolTip="Scraper status">
        <Canvas Width="220" Height="250">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="BobTransform" Y="0" />
                    <TranslateTransform x:Name="RunTransform" X="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Head group: antenna + ears + head + face + eyes + mouth + headset, all tilting
                 together as one unit (a subtle side-to-side "looking around" while walking). -->
            <Canvas x:Name="HeadGroup" Width="220" Height="250" RenderTransformOrigin="0.5,0.34">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="HeadTiltTransform" Angle="0" />
                </Canvas.RenderTransform>

                <!-- Antenna -->
                <Line X1="150" Y1="40" X2="168" Y2="12" Stroke="#7DFFB0" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse x:Name="AntennaDot" Canvas.Left="162" Canvas.Top="6" Width="12" Height="12" Fill="#7DFFB0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#7DFFB0" BlurRadius="2" ShadowDepth="0" Opacity="0.9" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Ears -->
                <Ellipse Canvas.Left="32" Canvas.Top="100" Width="28" Height="36" Fill="{StaticResource HeadGrad}" />
                <Ellipse Canvas.Left="160" Canvas.Top="100" Width="28" Height="36" Fill="{StaticResource HeadGrad}" />

                <!-- Head -->
                <Ellipse Canvas.Left="30" Canvas.Top="43" Width="160" Height="144" Fill="{StaticResource HeadGrad}" />

                <!-- Face screen -->
                <Ellipse Canvas.Left="52" Canvas.Top="73" Width="116" Height="90" Fill="#155C33" />

                <!-- Scanline (clipped to the face ellipse) -->
                <Canvas Canvas.Left="52" Canvas.Top="73" Width="116" Height="90">
                    <Canvas.Clip>
                        <EllipseGeometry Center="58,45" RadiusX="58" RadiusY="45" />
                    </Canvas.Clip>
                    <Rectangle x:Name="ScanlineRect" Canvas.Left="0" Canvas.Top="43" Width="116" Height="4" Fill="#7DFFB0" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanlineTransform" Y="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>

                <!-- Eyes -->
                <Ellipse x:Name="EyeLeft" Canvas.Left="79" Canvas.Top="96" Width="18" Height="32" Fill="#7DFFB0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="EyeRight" Canvas.Left="123" Canvas.Top="96" Width="18" Height="32" Fill="#7DFFB0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Mouth -->
                <Path x:Name="Mouth" Data="M 92 142 Q 110 160 128 142 L 128 142 Q 110 148 92 142 Z" Fill="#EAFFF2"
                      RenderTransformOrigin="0.5,0">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleY="1" />
                    </Path.RenderTransform>
                </Path>

                <!-- Headset -->
                <Path Data="M 165 110 Q 190 120 178 150 L 150 158" Stroke="#7DFFB0" StrokeThickness="5" StrokeStartLineCap="Round" Fill="{x:Null}" />
                <Ellipse x:Name="MicTip" Canvas.Left="144" Canvas.Top="152" Width="12" Height="12" Fill="#7DFFB0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#7DFFB0" BlurRadius="1" ShadowDepth="0" Opacity="0.9" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- Arms: rest at -25/25 (akimbo); the always-on walk animation swings each through
                 that resting angle, e.g. -40..-10, rather than starting from a flat 0. -->
            <Ellipse x:Name="ArmLeft" Canvas.Left="35" Canvas.Top="171" Width="40" Height="68" Fill="{StaticResource BodyGrad}"
                     RenderTransformOrigin="0.5,0">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-25" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="ArmRight" Canvas.Left="145" Canvas.Top="171" Width="40" Height="68" Fill="{StaticResource BodyGrad}"
                     RenderTransformOrigin="0.5,0">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="25" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Body -->
            <Path Data="M 70 195 Q 70 175 110 175 Q 150 175 150 195 L 150 225 Q 150 245 110 245 Q 70 245 70 225 Z" Fill="{StaticResource BodyGrad}" />
            <Ellipse x:Name="ChestLight" Canvas.Left="103" Canvas.Top="193" Width="14" Height="14" Fill="#7DFFB0" Opacity="0.5" />

            <!-- Foot -->
            <Ellipse Canvas.Left="94" Canvas.Top="232" Width="32" Height="20" Fill="#1F6B40" />
        </Canvas>
    </Viewbox>
</UserControl>
